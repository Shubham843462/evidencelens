# demo => offline deterministic responses built from real extracted frames.
#         No API calls or credits used. Output is NOT evidence of model capability.
# live => real multimodal model calls with the uploaded video's sampled frames.
EVIDENCELENS_MODE=demo
OPENAI_API_KEY=
# Change to an image-capable model available in your API account.
OPENAI_MODEL=gpt-4.1-mini

# Audio understanding (live mode): pre-cutoff speech is transcribed with Whisper
# and added to the prompt as unverified prior context.
# EVIDENCELENS_TRANSCRIBE=1             # set 0 to disable transcription
# EVIDENCELENS_WHISPER_MODEL=whisper-1  # OpenAI speech-to-text model

# Optional upload limits and processing settings (defaults shown).
# EVIDENCELENS_MAX_BYTES=104857600      # 100 MB
# EVIDENCELENS_MAX_DURATION_S=120       # 2 minutes
# EVIDENCELENS_TARGET_FRAMES=16         # frames sampled per analysis (2-20)
# EVIDENCELENS_FRAME_WIDTH=640          # extracted frame width in px
# EVIDENCELENS_CORS=http://localhost:5173,http://127.0.0.1:5173
